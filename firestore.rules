rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules tab -> Publish.
//
// Every quote and measurement sheet lives under /users/{their own uid}/...
// This single rule covers all of it: a signed-in user can only ever read or
// write documents under their OWN uid, never anyone else's. If this Firebase
// project is ever shared with an employee later, their data would be
// automatically, completely separated with no code changes needed here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
